

# Server Configuration
SERVER_PORT=9000

# PostgreSQL Database Configuration
DB_AUTH_USERNAME=postgres
DB_AUTH_PASSWORD=your_secure_db_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/playswap
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Spotify Developer API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google Cloud OAuth2 / YouTube Data API (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Keycloak / OAuth2 Resource Server Configuration
KEYCLOAK_URL=https://playswap-keycloak.up.railway.app
KEYCLOAK_REALM=playswap
KEYCLOAK_CLIENT_ID=playswap-web
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_if_confidential

# Security & Encryption (AES-128 / AES-256 for OAuth access token encryption at rest)
# Must be either a 16-character or 32-character secret string
AES_SECRET_KEY=16ByteSecretKey!

# Frontend Application URL (CORS and OAuth post-login redirect)
FRONTEND_URL=https://playswap-frontend-4xqptpaxl-jus-tech.vercel.app

# JVM Optimization Options (Optional - default is auto-configured for container limits)
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
